{
	"groups": {
		"group:superuser": [
			"kbpersonal@github",
			"LukeHouge@github",
			"rajsinghtech@github",
      "abtars@gmail.com",
		],
		"group:ottawa": [
			"kbpersonal@github",
			"rajsinghtech@github",
		],
		"group:robbinsdale": [
			"LukeHouge@github",
			"rajsinghtech@github",
		],
		"group:stpetersburg": [
			"rajsinghtech@github",
		],
		"group:aurora": [
			"rajsinghtech@github",
		],
	},
	"tagOwners": {
		"tag:infra":        ["tag:infra", "group:superuser",],
		"tag:k8s-operator": ["tag:k8s-operator", "tag:infra", "group:superuser",],
		"tag:k8s":          ["tag:k8s-operator", "tag:infra", "group:superuser",],
		"tag:k8s-recorder": ["tag:k8s-operator", "tag:infra", "group:superuser",],
		"tag:robbinsdale":  ["tag:k8s-operator", "tag:infra", "group:superuser", "group:robbinsdale",],
		"tag:ottawa":       ["tag:k8s-operator", "tag:infra", "group:superuser", "group:ottawa",],
		"tag:stpetersburg": ["tag:k8s-operator", "tag:infra", "group:superuser", "group:stpetersburg",],
		"tag:aurora":       ["tag:k8s-operator", "tag:infra", "group:superuser", "group:aurora",],
		"tag:ci":               ["tag:k8s-operator", "tag:infra", "group:superuser",],
		"tag:ssh-granted":      ["group:superuser",],
		"tag:raj":              ["tag:k8s-operator", "rajsinghtech@github",],
		"tag:kartik":           ["tag:k8s-operator", "kbpersonal@github",],
	},
	"ipsets": {
		"ipset:robbinsdale": [
			"192.168.50.0/24",
			"10.0.0.0/16",
			"10.1.0.0/16",
			"10.50.0.0/16",
			"fd7a:115c:a1e0:b1a:0:1::/96",
		],
		"ipset:ottawa": [
			"192.168.169.0/24",
			"10.2.0.0/16",
			"10.3.0.0/16",
			"10.169.0.0/16",
			"fd7a:115c:a1e0:b1a:0:2::/96",
		],
		"ipset:stpetersburg": [
			"192.168.73.0/24",
			"10.4.0.0/16",
			"10.5.0.0/16",
			"10.73.0.0/16",
			"fd7a:115c:a1e0:b1a:0:3::/96",
		],
		"ipset:aurora": [
			"192.168.68.0/24",
			"10.6.0.0/16",
			"10.7.0.0/16",
			"10.68.0.0/16",
			"fd7a:115c:a1e0:b1a:0:4::/96",
		],
	},
	"autoApprovers": {
		"exitNode": ["tag:k8s"],
		"routes": {
			"0.0.0.0/0":        ["tag:k8s"],
			"::/0":             ["tag:k8s"],
			"192.168.50.0/24":  ["tag:robbinsdale"],
			"192.168.169.0/24": ["tag:ottawa"],
			"192.168.73.0/24":  ["tag:stpetersburg"],
			"192.168.68.0/24":  ["tag:aurora"],
		},
		// The two tag entries let the operator claim service names as it creates
		// them; the per-svc entries below are redundant with those but kept as
		// the record of which names are deliberately auto-approved.
		"services": {
			"tag:k8s": ["tag:k8s"],
			"tag:k8s-operator": ["tag:k8s-operator"],
			"svc:tsdnsproxy": ["tag:k8s"],
			"svc:tempvm": ["tag:k8s"],
		},
	},
	"ssh": [
		{
			"action":          "accept",
			"src":             ["rajsinghtech@github"],
			"dst":             ["tag:aurora"],
			"users":           ["root", "autogroup:nonroot"],
			"recorder":        ["tag:k8s-recorder"],
			"enforceRecorder": true,
		},
		{
			"action":          "accept",
			"src":             ["group:superuser", "tag:k8s", "tag:ci"],
			"dst":             ["tag:ottawa", "tag:robbinsdale", "tag:stpetersburg", "tag:k8s"],
			"users":           ["root", "autogroup:nonroot"],
			"recorder":        ["tag:k8s-recorder"],
			"enforceRecorder": true,
		},
		{
			"action":          "accept",
			"src":             ["tag:ssh-granted"],
			"dst":             ["tag:ottawa", "tag:robbinsdale", "tag:stpetersburg", "tag:k8s"],
			"users":           ["root", "autogroup:nonroot"],
			"recorder":        ["tag:k8s-recorder"],
			"enforceRecorder": true,
		},
	],
	"postures": {
		"posture:jitSsh":   ["custom:jitSsh == true"],
	},
	"grants": [
		{
			"src": ["autogroup:member"],
			"dst": ["autogroup:self"],
			"ip":  ["*"],
		},
		{
			"src": ["rajsinghtech@github", "tag:raj"],
			"dst": ["tag:raj"],
			"ip":  ["*"],
		},
		{
			"src": ["kbpersonal@github", "tag:kartik"],
			"dst": ["tag:kartik"],
			"ip":  ["*"],
		},
		{
			"src": ["group:superuser", "tag:ottawa", "tag:robbinsdale", "tag:stpetersburg"],
			"dst": ["tag:ottawa", "tag:robbinsdale", "tag:stpetersburg"],
			"ip":  ["*"],
		},
		{
			"src": ["group:superuser"],
			"dst": ["svc:tempvm", "tag:k8s"],
			"ip":  ["*"],
		},
		{
			"src": ["group:ottawa"],
			"dst": ["svc:cliproxy"],
			"ip":  ["80"],
		},
		// Every member reaches the per-cluster home Envoy gateways; the gateways
		// themselves do the per-app authn/authz behind these ports.
		{
			"src": ["autogroup:member"],
			"dst": [
				"svc:ottawa-home-envoy-gateway",
				"svc:robbinsdale-home-envoy-gateway",
				"svc:stpetersburg-home-envoy-gateway",
			],
			"ip":  ["22", "53", "80", "443"],
		},
		{
			"src": ["tag:k8s"],
			"dst": ["rajsinghtech@github"],
			"ip":  ["*"],
		},
		// Exit nodes are for people, not machines: one grant for members instead
		// of the previous pair that also handed autogroup:internet to tag:k8s
		// and tag:ci, and gated the two admins on a home-IP posture.
		{
			"src": ["autogroup:member"],
			"dst": ["autogroup:internet"],
			"ip":  ["*"],
			"via": ["tag:robbinsdale", "tag:ottawa", "tag:stpetersburg"],
		},
		{
			"src": ["group:superuser", "tag:ottawa", "tag:stpetersburg", "tag:ci"],
			"dst": ["ipset:robbinsdale"],
			"ip":  ["*"],
			"via": ["tag:robbinsdale"],
		},
		{
			"src": ["group:superuser", "tag:robbinsdale", "tag:stpetersburg", "tag:ci"],
			"dst": ["ipset:ottawa"],
			"ip":  ["*"],
			"via": ["tag:ottawa"],
		},
		{
			"src": ["group:superuser", "tag:robbinsdale", "tag:ottawa", "tag:ci"],
			"dst": ["ipset:stpetersburg"],
			"ip":  ["*"],
			"via": ["tag:stpetersburg"],
		},
		{
			"src": ["group:superuser", "tag:robbinsdale", "tag:ottawa", "tag:stpetersburg", "tag:ci"],
			"dst": ["ipset:aurora"],
			"ip":  ["*"],
			"via": ["tag:aurora"],
		},
		{
			"src": ["group:superuser",],
			"dst": ["tag:k8s-operator", "tag:k8s"],
			"ip":  ["*"],
			"app": {
				"tailscale.com/cap/relay": [],
				"tailscale.com/cap/kubernetes": [
					{
						"impersonate": {
							"groups": ["system:masters"],
						},
						"recorder":        ["tag:k8s-recorder"],
						"enforceRecorder": true,
					},
				],
				"tailscale.com/cap/tsidp": [
					{
						"allow_admin_ui": true,
					},
				],
				"rajsingh.info/cap/tsdnsproxy": [
					{
						"robbinsdale.k8s": {
							"dns":     ["10.0.0.10:53"],
							"rewrite": "svc.cluster.local",
							"translateid": -1
						},
						"ottawa.k8s": {
							"dns":     ["10.2.0.10:53"],
							"rewrite": "svc.cluster.local",
							"translateid": -1
						},
						"stpetersburg.k8s": {
							"dns":     ["10.4.0.10:53"],
							"rewrite": "svc.cluster.local",
							"translateid": -1
						}
					}
				],
			},
		},
		{
			"src": ["tag:k8s"],
			"dst": ["tag:k8s-operator", "tag:k8s"],
			"ip":  ["*"],
			"app": {
				"tailscale.com/cap/relay": [],
				// tag:k8s is worn by ~109 devices — every ingress and egress proxy,
				// app connector, subnet router, recorder, and per-app ts-* sidecar.
				// It used to impersonate system:masters on all three clusters with
				// no recorder, so one compromised sidecar was fleet-wide
				// cluster-admin. Read-only, plus secret reads in the two namespaces
				// the ClusterSecretStores actually target (they authenticate only
				// by tailnet identity, passing "bearerToken: unused").
				"tailscale.com/cap/kubernetes": [
					{
						"impersonate": {
							"groups": ["tailnet-readers", "tailnet-secret-sync"],
						},
					},
				],
				"tailscale.com/cap/tsidp": [
					{
						"allow_admin_ui": true,
					},
				],
				"rajsingh.info/cap/tsdnsproxy": [
					{
						"robbinsdale.k8s": {
							"dns":     ["10.0.0.10:53"],
							"rewrite": "svc.cluster.local",
							"translateid": -1
						},
						"ottawa.k8s": {
							"dns":     ["10.2.0.10:53"],
							"rewrite": "svc.cluster.local",
							"translateid": -1
						},
						"stpetersburg.k8s": {
							"dns":     ["10.4.0.10:53"],
							"rewrite": "svc.cluster.local",
							"translateid": -1
						}
					}
				],
			},
		},
		{
			"src": ["group:superuser", "tag:k8s"],
			"dst": ["svc:tsdnsproxy"],
			"ip":  ["53"],
			"app": {
				"rajsingh.info/cap/tsdnsproxy": [
					{
						"robbinsdale.k8s": {
							"dns":     ["10.0.0.10:53"],
							"rewrite": "svc.cluster.local",
							"translateid": -1
						},
						"ottawa.k8s": {
							"dns":     ["10.2.0.10:53"],
							"rewrite": "svc.cluster.local",
							"translateid": -1
						},
						"stpetersburg.k8s": {
							"dns":     ["10.4.0.10:53"],
							"rewrite": "svc.cluster.local",
							"translateid": -1
						}
					}
				],
			},
		},
		// Read-only Kubernetes for any member, via the API server proxy only.
		// This used to carry dst tag:k8s + ip "*", which handed every member
		// all-ports access to ~109 tagged devices and — because an advertising
		// proxy folds its Tailscale Service VIPs into node-tag rules — to every
		// Tailscale Service in the tailnet.
		{
			"src": ["autogroup:member", "tag:ci"],
			"dst": ["tag:k8s-operator"],
			"ip":  ["443"],
			"app": {
				"tailscale.com/cap/kubernetes": [
					{
						"impersonate": {
							"groups": ["tailnet-readers"],
						},
						"recorder":        ["tag:k8s-recorder"],
						"enforceRecorder": true,
					},
				],
			},
		},
	],
	"nodeAttrs": [
		{
			"target": ["*"],
      "attr": [
        "traffic-steering",
      ],
			"app": {
				"tailscale.com/app-connectors": [
					// {
					// 	"name":        "aws-cloudfront-global",
					// 	"connectors":  ["tag:k8s"],
					// 	"presetAppID": "aws-cloudfront-global",
					// },
					// {
					// 	"name":        "app-github",
					// 	"connectors":  ["tag:k8s"],
					// 	"presetAppID": "github",
					// },
					{
						"name":       "tiktok",
						"connectors": ["tag:k8s"],
						"domains": [
							"tiktok.com",
							"tiktok.net",
							"v.tiktok.net",
							"tiktokcdn.com",
							"tiktokv.com",
							"v.tiktok.com",
							"musica.ly",
							"muscdn.com",
							"musemuse.cn",
							"ibyteimg.com",
							"p16-tiktokcdn-com.akamaized.net",
							"tiktok.com.c.footprint.net",
							"tiktokcdn.com.c.worldfcdn.com",
							"tiktokcdn.com.wsdvs.com",
							"tiktokcdn.liveplay.myqcloud.com",
							"byteoversea.com",
							"bytecdn.cn",
							"byted.org",
							"ibytedtos.com",
						],
					},
					{
						"name":       "shared",
						"connectors": ["tag:k8s"],
						"domains":    ["speed.cloudflare.com"],
					},
					{
						"name":       "robbinsdale",
						"connectors": ["tag:robbinsdale"],
						"domains": [
							"bestbuy.com",
						],
					},
					{
						"name":       "ottawa",
						"connectors": ["tag:ottawa"],
						"domains": [
							"newegg.com",
						],
					},
				],
			},
		},
		{
			"target": ["group:superuser"],
			"attr":   [
				// "experimental:exit-node-steering", // FF traffic-steering
				// "only-tcp-443", // FF allow-only-tcp-443
				// "custom:test" // FF metadata-node-set-attrs node-attributes-api
			],
		},

		{
			"target": ["tag:k8s"],
			"attr": [
				"funnel",
			],
		},
	],
	"tests": [
		{
			"src": "rajsinghtech@github",
			"proto": "icmp",
			"accept": [
				"tag:robbinsdale:0",
			],
		},
		{
			"src": "rajsinghtech@github",
			"accept": [
				"192.168.50.1:443",
				"192.168.169.1:443",
				"10.0.0.1:443",
				"10.1.0.1:443",
				"10.2.0.1:443",
				"tag:k8s-operator:443",
				"tag:k8s:443",
				"tag:ottawa:443",
				"tag:robbinsdale:443",
				"tag:stpetersburg:443",
				"rajsinghtech@github:53",
				"svc:cliproxy:80",
			],
		},
		{
			"src": "kbpersonal@github",
			"accept": [
				"svc:cliproxy:80",
			],
		},
		// A plain member (not in group:superuser) reaches the home gateways and
		// the API server proxy, nothing else.
		{
			"src": "rajsinghcpre@gmail.com",
			"accept": [
				"svc:ottawa-home-envoy-gateway:443",
				"svc:robbinsdale-home-envoy-gateway:443",
				"svc:stpetersburg-home-envoy-gateway:80",
				"svc:ottawa-home-envoy-gateway:22",
				"tag:k8s-operator:443",
			],
			"deny": [
				"tag:k8s:443",
				"tag:k8s-operator:22",
				"tag:ottawa:443",
				"svc:ottawa-zot:443",
				"svc:k9s:443",
				"svc:tsdnsproxy:53",
			],
		},
		{
			"src":   "rajsinghcpre@gmail.com",
			"proto": "udp",
			"accept": [
				"svc:robbinsdale-home-envoy-gateway:53",
			],
		},
		{
			"src": "tag:k8s",
			"accept": [
				"tag:k8s-operator:443",
				"tag:k8s:443",
			],
		},
		{
			"src": "tag:robbinsdale",
			"accept": [
				"192.168.169.1:443",
			],
			"deny": [
				"192.168.50.1:443",
			],
		},
		{
			"src": "tag:ottawa",
			"accept": [
				"192.168.50.1:443",
			],
			"deny": [
				"192.168.169.1:443",
			],
		},
		{
			"src": "group:superuser",
			"accept": [
				"svc:tempvm:5432",
				"tag:k8s:443",
				"tag:k8s-operator:443",
			],
		},
	],
  "attrConfig": {
    "custom:potato":      {"type": "string", "allowSetByNode": true, "broadcastToPeers": ["*"]},
    "custom:jitSsh":     {"type": "bool"},
  },
}
