			],
		},
		{
			"src":    "group:ottawa",
			"accept": ["svc:cliproxy:80"],
		},
		{
			"src": "rajsinghcpre@gmail.com",
			"accept": [
				"svc:ottawa-home-envoy-gateway:22",
				"svc:ottawa-home-envoy-gateway:443",
				"svc:robbinsdale-home-envoy-gateway:443",
				"svc:stpetersburg-home-envoy-gateway:80",
				"tag:k8s-operator:443",
			],
			"deny": [
				"tag:k8s:443",
				"tag:k8s-operator:22",
				"tag:ottawa:443",
				"tag:robbinsdale:443",
				"tag:stpetersburg:443",
				"svc:cliproxy:80",
				"svc:ottawa-zot:443",
				"svc:k9s:443",
				"svc:tempvm:5432",
				"svc:tsdnsproxy:53",
				"192.168.50.1:443",
				"192.168.169.1:443",
			],
		},
		{
			"src":    "rajsinghcpre@gmail.com",
			"proto":  "udp",
			"accept": ["svc:robbinsdale-home-envoy-gateway:53"],
		},
		{
			"src":    "tag:k8s",
			"accept": ["tag:k8s:443", "tag:k8s-operator:443"],
			"deny":   ["svc:cliproxy:80", "192.168.50.1:443"],
		},
		{
			"src":    "tag:robbinsdale",
			"accept": ["192.168.169.1:443", "192.168.73.1:443"],
			"deny":   ["192.168.50.1:443"],
		},
		{
			"src":    "tag:ottawa",
			"accept": ["192.168.50.1:443", "192.168.73.1:443"],
			"deny":   ["192.168.169.1:443"],
		},
		{
			"src":    "tag:stpetersburg",
			"accept": ["192.168.50.1:443", "192.168.169.1:443"],
			"deny":   ["192.168.73.1:443"],
		},
		{
			"src":  "tag:ci",
			"deny": ["svc:cliproxy:80", "svc:tempvm:5432"],
		},
	]
}
