#!/usr/bin/with-contenv bash
# shellcheck shell=bash
# Push the cliproxy -> agent variable mapping into s6's container environment.
#
# Writing files into /run/s6/container_environment is the s6-overlay way to
# export a variable to every service started afterwards, so the desktop session
# and anything launched from a GUI menu inherits these -- not just shells.
# The mapping itself lives in /etc/bot/agent-env.sh, which /etc/profile.d
# sources too.
set -euo pipefail

if [[ -z "${CLIPROXY_BASE_URL:-}" ]]; then
  echo "[bot-environment] CLIPROXY_BASE_URL unset; leaving agent env alone"
  exit 0
fi

# An empty key is the one failure that looks like a working desktop until the
# first agent call returns 401, so say so loudly at boot instead.
if [[ -z "${CLIPROXY_API_KEY:-}" ]]; then
  echo "[bot-environment] WARNING: CLIPROXY_API_KEY is empty -- agents will get 401."
  echo "[bot-environment]          add CLIPROXY_API_KEY to ottawa cluster-secrets."
fi

# shellcheck source=/dev/null
. /etc/bot/agent-env.sh

for var in ${BOT_AGENT_VARS}; do
  printf '%s' "${!var}" > "/run/s6/container_environment/${var}"
done

echo "[bot-environment] agent endpoints pointed at ${CLIPROXY_BASE_URL%/}"
