# Pinned tool versions for the bot/webtop maintainer image.
#
# Every entry is Renovate-managed through the "Track bot/webtop image tool
# versions" custom manager in .renovate/customManagers.json. Keep the
# "# renovate:" comment directly above its variable or the bump stops working.
#
# The base image tag is deliberately NOT version-pinned: the whole point of
# WEBTOP_BASE is that the desktop flavour is swappable (debian-xfce,
# debian-kde, ubuntu-mate, alpine-xfce, ...). LinuxServer publishes those as
# rolling tags, so there is no version for Renovate to track.
WEBTOP_BASE_IMAGE="lscr.io/linuxserver/webtop"
WEBTOP_BASE_TAG="debian-xfce"

# --- language toolchains -----------------------------------------------------
# renovate: datasource=golang-version depName=go
GO_VERSION="1.27.1"
# renovate: datasource=node-version depName=node
NODE_VERSION="24.21.0"
# uv also manages the Python interpreters, so there is no separate python pin.
# renovate: datasource=github-releases depName=astral-sh/uv
UV_VERSION="0.12.19"

# --- go tooling --------------------------------------------------------------
# renovate: datasource=github-releases depName=golangci/golangci-lint
GOLANGCI_LINT_VERSION="2.13.2"

# --- agents ------------------------------------------------------------------
# renovate: datasource=github-releases depName=NousResearch/hermes-agent
HERMES_VERSION="v2026.9.24"
# renovate: datasource=github-releases depName=herdrdev/herdr
HERDR_VERSION="0.9.1"
# Tracked through npm because the GitHub tags carry a "rust-v" prefix that the
# release asset URLs also use; the npm package version is the bare semver.
# renovate: datasource=npm depName=@openai/codex
CODEX_VERSION="0.156.0"
# renovate: datasource=npm depName=@anthropic-ai/claude-code
CLAUDE_CODE_VERSION="2.1.282"

# --- kubernetes / gitops tooling --------------------------------------------
# Keep KUBECTL_VERSION in step with aqua.yaml; both track the fleet's API server.
# renovate: datasource=github-releases depName=kubernetes/kubernetes
KUBECTL_VERSION="1.37.0"
# renovate: datasource=github-releases depName=helm/helm
HELM_VERSION="4.3.0"
# renovate: datasource=github-releases depName=fluxcd/flux2
FLUX_VERSION="2.9.5"
# Kustomize is tracked by the dedicated Renovate custom manager (extractVersionTemplate strips the kustomize/ tag prefix).
# Do not add a "# renovate:" line here — it would double-match the generic versions manager.
KUSTOMIZE_VERSION="5.8.1"
# Matches talosVersion in clusters/talos-ottawa/bootstrap/talos/talconfig.yaml.
# renovate: datasource=github-releases depName=siderolabs/talos
TALOSCTL_VERSION="1.13.7"
# renovate: datasource=github-releases depName=getsops/sops
SOPS_VERSION="3.13.3"
# renovate: datasource=github-releases depName=FiloSottile/age
AGE_VERSION="1.3.2"
# renovate: datasource=github-releases depName=cli/cli
GH_VERSION="2.101.0"
# renovate: datasource=github-releases depName=mikefarah/yq
YQ_VERSION="4.53.6"
