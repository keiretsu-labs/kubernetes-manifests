# tinyauth-killinit — SECOND tinyauth instance, scoped to killinit.cc.
#
# WHY THIS EXISTS: tinyauth derives ONE session-cookie domain from APPURL at
# bootstrap (app_utils.go GetCookieDomain). The primary instance uses
# APPURL=auth.keiretsu.top -> cookie domain `keiretsu.top`, which the browser
# will NEVER send to a `*.killinit.cc` host. So cookie-based extAuth on Ottawa's
# killinit.cc apps (e.g. Suwayomi) loops forever: authenticate -> cookie set on
# keiretsu.top -> bounce back to killinit.cc -> no cookie -> re-auth -> loop.
# One tinyauth per registrable domain is the fix. This instance's APPURL is on
# killinit.cc, so its cookie is in-scope for suwayomi.killinit.cc and any other
# Ottawa killinit.cc app put behind its extAuth.
#
# This instance is extAuth-ONLY. It is NOT the OIDC IdP — apps that do their own
# OIDC (Komga, Omnibus, BookOrbit, …) keep pointing at auth.keiretsu.top.
#
# Rendered by a configMapGenerator so its name carries a content hash: editing
# this file rewrites the deployment's envFrom ref and rolls the pod.
TINYAUTH_APPURL=https://auth.killinit.cc
# v5.1.0 auto-enables a Kubernetes label provider that does a cluster-scoped
# ingress list at bootstrap and crashes without RBAC. We drive ACLs via env +
# HTTPRoute SecurityPolicies, not ingress labels — disable it.
TINYAUTH_LABELPROVIDER=none
TINYAUTH_UI_TITLE=keiretsu labs auth (ottawa)
TINYAUTH_OAUTH_PROVIDERS_google_NAME=Google
TINYAUTH_SERVER_PORT=3000
TINYAUTH_AUTH_SESSIONEXPIRY=86400
TINYAUTH_AUTH_SECURECOOKIE=true
TINYAUTH_OAUTH_AUTOREDIRECT=google
TINYAUTH_AUTH_TRUSTEDPROXIES=10.0.0.0/8,192.168.0.0/16
TINYAUTH_ANALYTICS_ENABLED=false
# UI / branding (customer-facing). Same custom background as the primary
# instance, served from /resources (mounted from tinyauth-resources). Without
# these, tinyauth serves its bundled default /background.jpg (the forest photo).
TINYAUTH_RESOURCES_ENABLED=true
TINYAUTH_RESOURCES_PATH=/resources
TINYAUTH_UI_BACKGROUNDIMAGE=/resources/background.svg
TINYAUTH_UI_WARNINGSENABLED=false
# authN allowlist — same gate as the primary instance: only these emails may
# complete OAuth. Add a person here (one commit) to grant killinit.cc app access.
TINYAUTH_OAUTH_WHITELIST=kartikbharath@gmail.com,rajsinghcpre@gmail.com
# OIDC server keys live on the PVC (auto-created first start). Present for parity;
# this instance is used for extAuth, not as a downstream IdP.
TINYAUTH_OIDC_PRIVATEKEYPATH=/data/oidc/private.pem
TINYAUTH_OIDC_PUBLICKEYPATH=/data/oidc/public.pem
